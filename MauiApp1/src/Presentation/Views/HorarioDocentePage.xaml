<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.src.Presentation.Views.HorarioDocentePage"
              NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F9FAFB">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#1967D2</Color>
            <Color x:Key="TextPrimary">#1F2937</Color>
            <Color x:Key="TextSecondary">#6B7280</Color>
            <Color x:Key="CardBackground">#FFFFFF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" 
                BackgroundColor="White" 
                Padding="20,15"
                StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.08"/>
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*">
                <!-- Botón Volver -->
                <Border Grid.Column="0"
                        WidthRequest="40"
                        HeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="#F3F4F6"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVolverClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="←"
                           FontSize="22"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <!-- Información del Docente -->
                <VerticalStackLayout Grid.Column="1" 
                                   Spacing="2" 
                                   VerticalOptions="Center"
                                   Margin="15,0,0,0">
                    <Label x:Name="lblNombreDocente"
                           Text="Nombre Docente"
                           FontFamily="InterBold"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"/>
                    <Label x:Name="lblEspecialidad"
                           Text="Especialidad"
                           FontSize="13"
                           TextColor="{StaticResource TextSecondary}"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Contenido Principal con Horario -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="15" Spacing="15">

                <!-- Título de Sección -->
                <Label Text="📅 Horario Semanal"
                       FontFamily="InterBold"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"/>

                <!-- Tabla de Horarios -->
                <Border BackgroundColor="White"
                        Padding="0"
                        StrokeThickness="1"
                        Stroke="#E5E7EB">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06"/>
                    </Border.Shadow>

                    <ScrollView Orientation="Horizontal">
                        <VerticalStackLayout x:Name="tablaHorario" Spacing="0">
                            <!-- La tabla se generará dinámicamente aquí -->
                        </VerticalStackLayout>
                    </ScrollView>
                </Border>

                <!-- Botones de Acción -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                    <Button Grid.Column="0"
                            Text="➕ Asignar Grupo"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="45"
                            Clicked="OnAsignarGrupoClicked"/>

                    <Button Grid.Column="1"
                            Text="📋 Ver Grupos"
                            BackgroundColor="#10B981"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="45"
                            Clicked="OnVerGruposClicked"/>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Indicator -->
        <ActivityIndicator x:Name="loadingIndicator"
                          Grid.Row="1"
                          IsRunning="False"
                          IsVisible="False"
                          Color="{StaticResource Primary}"
                          VerticalOptions="Center"
                          HorizontalOptions="Center"/>

    </Grid>

</ContentPage>