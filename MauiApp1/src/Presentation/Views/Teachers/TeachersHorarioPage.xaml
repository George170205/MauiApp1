<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.TeachersHorarioPage"
             Title="Horarios de clase">

    <Grid BackgroundColor="#F5F5F5">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Header -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12" 
                       Padding="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Button Text="←" 
                                FontSize="24"
                                BackgroundColor="Transparent"
                                TextColor="#2C3E50"
                                HorizontalOptions="Start"
                                WidthRequest="50"
                                Clicked="OnBackClicked"/>

                        <Label Text="Horarios de clase" 
                               FontSize="20" 
                               FontAttributes="Bold"
                               TextColor="#2C3E50"
                               HorizontalOptions="Center"/>
                        <Label Text="2 February 16 (Lunes)" 
                               FontSize="12" 
                               TextColor="#7F8C8D"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Perfil del docente -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12" 
                       Padding="15"
                       HasShadow="True">
                    <HorizontalStackLayout Spacing="15">
                        <Frame BackgroundColor="#4CAF50" 
                               CornerRadius="30" 
                               Padding="0"
                               WidthRequest="50" 
                               HeightRequest="50"
                               HasShadow="False">
                            <Label Text="RL" 
                                   FontSize="20" 
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                        <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                            <Label Text="Rodrigo Lara" 
                                   FontSize="16" 
                                   FontAttributes="Bold"
                                   TextColor="#2C3E50"/>
                            <Label Text="Doctor en Genética de Doctores" 
                                   FontSize="11" 
                                   TextColor="#7F8C8D"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Frame>

                <!-- Día selector -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12" 
                       Padding="0"
                       HasShadow="True">
                    <Label Text="Lunes" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="#2C3E50"
                           Padding="15"
                           BackgroundColor="#E8F5E9"
                           HorizontalOptions="Center"/>
                </Frame>

                <!-- Horario de clases -->
                <VerticalStackLayout Spacing="0">

                    <!-- 8 am -->
                    <Grid ColumnDefinitions="60,*" 
                          Padding="10,0" 
                          Margin="0,5">
                        <Label Grid.Column="0" 
                               Text="8 am" 
                               FontSize="12" 
                               TextColor="#7F8C8D"
                               VerticalOptions="Start"
                               Margin="0,10,0,0"/>

                        <Frame Grid.Column="1" 
                               BackgroundColor="White" 
                               CornerRadius="8" 
                               Padding="12"
                               HasShadow="True">
                            <HorizontalStackLayout Spacing="10">
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                    <Label Text="Gestión de seguridad en redes" 
                                           FontSize="14" 
                                           FontAttributes="Bold"
                                           TextColor="#2C3E50"/>
                                    <Label Text="Aula 022 - Laboratorio" 
                                           FontSize="11" 
                                           TextColor="#7F8C8D"/>
                                </VerticalStackLayout>
                                <Button Text="⋮" 
                                        FontSize="20"
                                        BackgroundColor="Transparent"
                                        TextColor="#7F8C8D"
                                        WidthRequest="40"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </Grid>

                    <!-- 9 am -->
                    <Grid ColumnDefinitions="60,*" 
                          Padding="10,0" 
                          Margin="0,5">
                        <Label Grid.Column="0" 
                               Text="9 am" 
                               FontSize="12" 
                               TextColor="#7F8C8D"
                               VerticalOptions="Start"
                               Margin="0,10,0,0"/>

                        <Frame Grid.Column="1" 
                               BackgroundColor="White" 
                               CornerRadius="8" 
                               Padding="12"
                               HasShadow="True">
                            <HorizontalStackLayout Spacing="10">
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                    <Label Text="Gestión de seguridad en redes" 
                                           FontSize="14" 
                                           FontAttributes="Bold"
                                           TextColor="#2C3E50"/>
                                    <Label Text="Aula 022 - Laboratorio" 
                                           FontSize="11" 
                                           TextColor="#7F8C8D"/>
                                </VerticalStackLayout>
                                <Button Text="⋮" 
                                        FontSize="20"
                                        BackgroundColor="Transparent"
                                        TextColor="#7F8C8D"
                                        WidthRequest="40"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </Grid>

                    <!-- 10 am -->
                    <Grid ColumnDefinitions="60,*" 
                          Padding="10,0" 
                          Margin="0,5">
                        <Label Grid.Column="0" 
                               Text="10 am" 
                               FontSize="12" 
                               TextColor="#7F8C8D"
                               VerticalOptions="Start"
                               Margin="0,10,0,0"/>

                        <Frame Grid.Column="1" 
                               BackgroundColor="White" 
                               CornerRadius="8" 
                               Padding="12"
                               HasShadow="True">
                            <HorizontalStackLayout Spacing="10">
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                    <Label Text="Aplicaciones Móviles" 
                                           FontSize="14" 
                                           FontAttributes="Bold"
                                           TextColor="#2C3E50"/>
                                    <Label Text="Aula 022 - Taller" 
                                           FontSize="11" 
                                           TextColor="#7F8C8D"/>
                                </VerticalStackLayout>
                                <Button Text="⋮" 
                                        FontSize="20"
                                        BackgroundColor="Transparent"
                                        TextColor="#7F8C8D"
                                        WidthRequest="40"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </Grid>

                    <!-- 11 am -->
                    <Grid ColumnDefinitions="60,*" 
                          Padding="10,0" 
                          Margin="0,5">
                        <Label Grid.Column="0" 
                               Text="11 am" 
                               FontSize="12" 
                               TextColor="#7F8C8D"
                               VerticalOptions="Start"
                               Margin="0,10,0,0"/>

                        <Frame Grid.Column="1" 
                               BackgroundColor="White" 
                               CornerRadius="8" 
                               Padding="12"
                               HasShadow="True">
                            <HorizontalStackLayout Spacing="10">
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                    <Label Text="Aplicaciones Móviles" 
                                           FontSize="14" 
                                           FontAttributes="Bold"
                                           TextColor="#2C3E50"/>
                                    <Label Text="Aula 022 - Taller" 
                                           FontSize="11" 
                                           TextColor="#7F8C8D"/>
                                </VerticalStackLayout>
                                <Button Text="⋮" 
                                        FontSize="20"
                                        BackgroundColor="Transparent"
                                        TextColor="#7F8C8D"
                                        WidthRequest="40"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </Grid>

                    <!-- 12 pm -->
                    <Grid ColumnDefinitions="60,*" 
                          Padding="10,0" 
                          Margin="0,5">
                        <Label Grid.Column="0" 
                               Text="12 pm" 
                               FontSize="12" 
                               TextColor="#E74C3C"
                               VerticalOptions="Start"
                               Margin="0,10,0,0"/>

                        <Frame Grid.Column="1" 
                               BackgroundColor="White" 
                               CornerRadius="8" 
                               Padding="12"
                               HasShadow="True"
                               BorderColor="#E74C3C">
                            <HorizontalStackLayout Spacing="10">
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                    <Label Text="Aplicaciones Móviles" 
                                           FontSize="14" 
                                           FontAttributes="Bold"
                                           TextColor="#2C3E50"/>
                                    <Label Text="Aula 022 - Taller" 
                                           FontSize="11" 
                                           TextColor="#7F8C8D"/>
                                </VerticalStackLayout>
                                <Button Text="⋮" 
                                        FontSize="20"
                                        BackgroundColor="Transparent"
                                        TextColor="#7F8C8D"
                                        WidthRequest="40"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </Grid>

                    <!-- 1 pm - 2 pm -->
                    <Grid ColumnDefinitions="60,*" 
                          Padding="10,0" 
                          Margin="0,5">
                        <Label Grid.Column="0" 
                               Text="1 pm" 
                               FontSize="12" 
                               TextColor="#7F8C8D"
                               VerticalOptions="Start"
                               Margin="0,10,0,0"/>
                    </Grid>

                    <!-- 2 pm -->
                    <Grid ColumnDefinitions="60,*" 
                          Padding="10,0" 
                          Margin="0,5">
                        <Label Grid.Column="0" 
                               Text="2 pm" 
                               FontSize="12" 
                               TextColor="#7F8C8D"
                               VerticalOptions="Start"
                               Margin="0,10,0,0"/>

                        <Frame Grid.Column="1" 
                               BackgroundColor="White" 
                               CornerRadius="8" 
                               Padding="12"
                               HasShadow="True">
                            <HorizontalStackLayout Spacing="10">
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                    <Label Text="Desarrollo Organizacional" 
                                           FontSize="14" 
                                           FontAttributes="Bold"
                                           TextColor="#2C3E50"/>
                                    <Label Text="Aula 022 - Laboratorio" 
                                           FontSize="11" 
                                           TextColor="#7F8C8D"/>
                                </VerticalStackLayout>
                                <Button Text="⋮" 
                                        FontSize="20"
                                        BackgroundColor="Transparent"
                                        TextColor="#7F8C8D"
                                        WidthRequest="40"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </Grid>

                    <!-- 3 pm -->
                    <Grid ColumnDefinitions="60,*" 
                          Padding="10,0" 
                          Margin="0,5">
                        <Label Grid.Column="0" 
                               Text="3 pm" 
                               FontSize="12" 
                               TextColor="#7F8C8D"
                               VerticalOptions="Start"
                               Margin="0,10,0,0"/>

                        <Frame Grid.Column="1" 
                               BackgroundColor="White" 
                               CornerRadius="8" 
                               Padding="12"
                               HasShadow="True">
                            <HorizontalStackLayout Spacing="10">
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                    <Label Text="Desarrollo Organizacional" 
                                           FontSize="14" 
                                           FontAttributes="Bold"
                                           TextColor="#2C3E50"/>
                                    <Label Text="Aula 022 - Taller" 
                                           FontSize="11" 
                                           TextColor="#7F8C8D"/>
                                </VerticalStackLayout>
                                <Button Text="⋮" 
                                        FontSize="20"
                                        BackgroundColor="Transparent"
                                        TextColor="#7F8C8D"
                                        WidthRequest="40"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </Grid>

                    <!-- 4 pm -->
                    <Grid ColumnDefinitions="60,*" 
                          Padding="10,0" 
                          Margin="0,5">
                        <Label Grid.Column="0" 
                               Text="4 pm" 
                               FontSize="12" 
                               TextColor="#7F8C8D"
                               VerticalOptions="Start"
                               Margin="0,10,0,0"/>

                        <Frame Grid.Column="1" 
                               BackgroundColor="White" 
                               CornerRadius="8" 
                               Padding="12"
                               HasShadow="True">
                            <HorizontalStackLayout Spacing="10">
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                    <Label Text="Análisis y desarrollo de Software" 
                                           FontSize="14" 
                                           FontAttributes="Bold"
                                           TextColor="#2C3E50"/>
                                    <Label Text="Aula Virtual" 
                                           FontSize="11" 
                                           TextColor="#7F8C8D"/>
                                </VerticalStackLayout>
                                <Button Text="⋮" 
                                        FontSize="20"
                                        BackgroundColor="Transparent"
                                        TextColor="#7F8C8D"
                                        WidthRequest="40"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </Grid>

                </VerticalStackLayout>

                <BoxView HeightRequest="80"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Navigation Bar -->
        <Frame VerticalOptions="End" 
               BackgroundColor="White" 
               CornerRadius="0" 
               Padding="0"
               HasShadow="True">
            <Grid ColumnDefinitions="*,*,*" 
                  Padding="10,5"
                  HeightRequest="60">

                <VerticalStackLayout Grid.Column="0" 
                                     Spacing="5"
                                     HorizontalOptions="Center">
                    <Button Text="🏠" 
                            FontSize="24"
                            BackgroundColor="Transparent"
                            TextColor="#7F8C8D"
                            Clicked="OnInicioClicked"/>
                    <Label Text="Inicio" 
                           FontSize="11" 
                           TextColor="#7F8C8D"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" 
                                     Spacing="5"
                                     HorizontalOptions="Center">
                    <Button Text="📅" 
                            FontSize="24"
                            BackgroundColor="Transparent"
                            TextColor="#3498DB"
                            Clicked="OnHorarioClicked"/>
                    <Label Text="Horario" 
                           FontSize="11" 
                           TextColor="#3498DB"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" 
                                     Spacing="5"
                                     HorizontalOptions="Center">
                    <Button Text="👤" 
                            FontSize="24"
                            BackgroundColor="Transparent"
                            TextColor="#7F8C8D"
                            Clicked="OnPerfilClicked"/>
                    <Label Text="Perfil" 
                           FontSize="11" 
                           TextColor="#7F8C8D"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>
