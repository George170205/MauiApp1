<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.src.Presentation.Views.DocentesPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F9FAFB">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#1967D2</Color>
            <Color x:Key="TextPrimary">#1F2937</Color>
            <Color x:Key="TextSecondary">#6B7280</Color>
            <Color x:Key="CardBackground">#FFFFFF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" 
                BackgroundColor="White" 
                Padding="20,15"
                StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.08"/>
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Botón Volver -->
                <Border Grid.Column="0"
                        WidthRequest="40"
                        HeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="#F3F4F6"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVolverClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="←"
                           FontSize="22"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <!-- Título -->
                <VerticalStackLayout Grid.Column="1" 
                                   Spacing="2" 
                                   VerticalOptions="Center"
                                   Margin="15,0,0,0">
                    <Label Text="Gestión de Docentes"
                           FontFamily="InterBold"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"/>
                    <Label x:Name="lblTotalDocentes"
                           Text="0 docentes registrados"
                           FontSize="13"
                           TextColor="{StaticResource TextSecondary}"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Contenido Principal -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="15" Spacing="15">

                <!-- Lista de Docentes -->
                <VerticalStackLayout x:Name="listaDocentes" Spacing="12">
                    <!-- Los docentes se cargarán dinámicamente aquí -->
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Indicator -->
        <ActivityIndicator x:Name="loadingIndicator"
                          Grid.Row="1"
                          IsRunning="False"
                          IsVisible="False"
                          Color="{StaticResource Primary}"
                          VerticalOptions="Center"
                          HorizontalOptions="Center"/>

    </Grid>
</ContentPage>
