<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.src.Presentation.Views.DistribucionGruposPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F9FAFB">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#1967D2</Color>
            <Color x:Key="TextPrimary">#1F2937</Color>
            <Color x:Key="TextSecondary">#6B7280</Color>
            <Color x:Key="CardBackground">#FFFFFF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" 
                BackgroundColor="White" 
                Padding="20,15"
                StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.08"/>
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*">
                <!-- Botón Volver -->
                <Border Grid.Column="0"
                        WidthRequest="40"
                        HeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="#F3F4F6"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVolverClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="←"
                           FontSize="22"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <!-- Título -->
                <VerticalStackLayout Grid.Column="1" 
                                   Spacing="2" 
                                   VerticalOptions="Center"
                                   Margin="15,0,0,0">
                    <Label Text="Distribución de Grupos"
                           FontFamily="InterBold"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"/>
                    <Label x:Name="lblTotalAlumnos"
                           Text="0 alumnos en 0 grupos"
                           FontSize="13"
                           TextColor="{StaticResource TextSecondary}"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Contenido Principal -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="15" Spacing="20">

                <!-- Card con Gráfica -->
                <Border BackgroundColor="White"
                        Padding="20"
                        StrokeThickness="1"
                        Stroke="#E5E7EB">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20">
                        <!-- Título de la Gráfica -->
                        <Label Text="📊 Distribución por Grupo"
                               FontFamily="InterBold"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center"/>

                        <!-- Canvas para la Gráfica de Pastel -->
                        <Grid x:Name="chartContainer"
                              HeightRequest="280"
                              WidthRequest="280"
                              HorizontalOptions="Center">
                            <GraphicsView x:Name="pieChartView"
                                         HeightRequest="280"
                                         WidthRequest="280"/>
                        </Grid>

                        <!-- Instrucciones -->
                        <Label Text="👆 Toca un segmento para ver los alumnos"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Leyenda de Colores -->
                <Border BackgroundColor="White"
                        Padding="15"
                        StrokeThickness="1"
                        Stroke="#E5E7EB">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="📋 Leyenda"
                               FontFamily="InterBold"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>

                        <VerticalStackLayout x:Name="leyendaContainer" Spacing="10">
                            <!-- La leyenda se generará dinámicamente -->
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Resumen Estadístico -->
                <Border BackgroundColor="White"
                        Padding="15"
                        StrokeThickness="1"
                        Stroke="#E5E7EB">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="📈 Estadísticas"
                               FontFamily="InterBold"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="15" RowSpacing="15">
                            <VerticalStackLayout Grid.Column="0" Grid.Row="0" Spacing="5">
                                <Label Text="Total Grupos"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"/>
                                <Label x:Name="lblTotalGrupos"
                                       Text="0"
                                       FontFamily="InterBold"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Grid.Row="0" Spacing="5">
                                <Label Text="Total Alumnos"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"/>
                                <Label x:Name="lblTotalAlumnosStats"
                                       Text="0"
                                       FontFamily="InterBold"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="#10B981"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="0" Grid.Row="1" Spacing="5">
                                <Label Text="Promedio por Grupo"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"/>
                                <Label x:Name="lblPromedioGrupo"
                                       Text="0"
                                       FontFamily="InterBold"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="#F59E0B"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Grid.Row="1" Spacing="5">
                                <Label Text="Grupo Más Grande"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"/>
                                <Label x:Name="lblGrupoMasGrande"
                                       Text="-"
                                       FontFamily="InterBold"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#EF4444"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Indicator -->
        <ActivityIndicator x:Name="loadingIndicator"
                          Grid.Row="1"
                          IsRunning="False"
                          IsVisible="False"
                          Color="{StaticResource Primary}"
                          VerticalOptions="Center"
                          HorizontalOptions="Center"/>

    </Grid>

</ContentPage>