<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.src.Presentation.Views.HorarioAlumnoPage"
             BackgroundColor="#F4F6FA"
             Title="Horario">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="#1A1A2E" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *">

        <VerticalStackLayout Grid.Row="0" Padding="24,20,24,10" Spacing="4">
            <Label Text="Tu Horario" FontSize="24" FontAttributes="Bold" />
            <Label Text="Revisa tus clases programadas" FontSize="14" TextColor="#6B7280" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding DiasSemana}" 
                        HorizontalOptions="Center" 
                        Margin="0,10,0,20"
                        HeightRequest="60">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeThickness="0" 
                            BackgroundColor="{Binding BgColor}"
                            WidthRequest="44" 
                            HeightRequest="44"
                            StrokeShape="RoundRectangle 22"
                            VerticalOptions="Center">
                        <Label Text="{Binding Letra}" 
                               TextColor="{Binding TextColor}"
                               FontSize="16" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SeleccionarDiaCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView Grid.Row="2" 
                        ItemsSource="{Binding ClasesDelDia}" 
                        Margin="24,0,24,24">

            <CollectionView.Header>
                <Label Text="{Binding DiaActualTexto}" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       Margin="0,0,0,16" />
            </CollectionView.Header>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeThickness="1" 
                            Stroke="#E8ECF0"
                            BackgroundColor="White" 
                            StrokeShape="RoundRectangle 16"
                            Padding="0">

                        <Grid ColumnDefinitions="75, 4, *">

                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding HoraInicio}" FontSize="14" FontAttributes="Bold" TextColor="#1E3A5F" HorizontalOptions="Center" />
                                <Label Text="{Binding HoraFin}" FontSize="12" TextColor="#9CA3AF" HorizontalOptions="Center" />
                            </VerticalStackLayout>

                            <BoxView Grid.Column="1" Color="{Binding Acento}" CornerRadius="2" Margin="0,12" />

                            <VerticalStackLayout Grid.Column="2" Padding="16" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Nombre}" FontSize="16" FontAttributes="Bold" />
                                <Label Text="{Binding Profesor}" FontSize="13" TextColor="#6B7280" />
                                <Label Text="{Binding Salon}" FontSize="12" TextColor="#9CA3AF" Margin="0,4,0,0" />
                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>