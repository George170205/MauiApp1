<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.src.Presentation.Views.AsistenciaPage"
             BackgroundColor="#F4F6FA"
             Title="Asistencia">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="#1A1A2E" />
        </Style>
        <Style TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="#E8ECF0" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <!-- Header fecha -->
            <Border StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout Spacing="4">
                    <Label
                        Text="Hoy es"
                        FontSize="13"
                        TextColor="#6B7280" />
                    <Label
                        Text="{Binding FechaHoy}"
                        FontSize="20"
                        FontAttributes="Bold" />
                    <Label
                        Text="{Binding HoraActual}"
                        FontSize="13"
                        TextColor="#2563EB"
                        FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- Clase actual -->
            <VerticalStackLayout Spacing="10">

                <Label
                    Text="Clase actual"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#6B7280" />

                <Border
                    StrokeShape="RoundRectangle 20"
                    Padding="20"
                    BackgroundColor="#2563EB"
                    StrokeThickness="0">

                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="{Binding ClaseActual.Nombre}"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="{Binding ClaseActual.Profesor}"
                            FontSize="14"
                            TextColor="#FFFFFFCC" />

                        <BoxView HeightRequest="1" Color="#FFFFFF33" />

                        <Grid ColumnDefinitions="*,*,*">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Inicio" FontSize="11" TextColor="#FFFFFF99" />
                                <Label Text="{Binding ClaseActual.HoraInicio}" FontSize="14" FontAttributes="Bold" TextColor="White" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Fin" FontSize="11" TextColor="#FFFFFF99" />
                                <Label Text="{Binding ClaseActual.HoraFin}" FontSize="14" FontAttributes="Bold" TextColor="White" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="Salón" FontSize="11" TextColor="#FFFFFF99" />
                                <Label Text="{Binding ClaseActual.Salon}" FontSize="14" FontAttributes="Bold" TextColor="White" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

            <!-- Registrar asistencia -->
            <!-- Registrar asistencia -->
            <VerticalStackLayout Spacing="12">

                <Label
        Text="Registrar asistencia"
        FontSize="14"
        FontAttributes="Bold"
        TextColor="#6B7280" />

                <!-- Botón escanear -->
                <Border
        StrokeShape="RoundRectangle 18"
        BackgroundColor="White"
        Stroke="#DBEAFE"
        StrokeThickness="1.5"
        Padding="16"
        Style="{x:Null}">
                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <Border
                Grid.Column="0"
                WidthRequest="52"
                HeightRequest="52"
                BackgroundColor="#2563EB"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 14"
                VerticalOptions="Center"
                Style="{x:Null}">
                            <Image
                    Source="qr_icon.svg"
                 
                    WidthRequest="26"
                    HeightRequest="26"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3" Margin="14,0,0,0">
                            <Label Text="Escanear código QR" FontSize="15" FontAttributes="Bold" TextColor="#1E3A5F" />
                            <Label Text="Apunta la cámara al código" FontSize="12" TextColor="#6B7280" />
                        </VerticalStackLayout>

                        <Label
                Grid.Column="2"
                Text="›"
                FontSize="24"
                TextColor="#2563EB"
                VerticalOptions="Center" />

                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding EscanearCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Botón manual -->
                <Border
        StrokeShape="RoundRectangle 18"
        BackgroundColor="White"
        Stroke="#FCE7D6"
        StrokeThickness="1.5"
        Padding="16"
        Style="{x:Null}">
                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <Border
                Grid.Column="0"
                WidthRequest="52"
                HeightRequest="52"
                BackgroundColor="#EA580C"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 14"
                VerticalOptions="Center"
                Style="{x:Null}">
                            <Image
                    Source="pencil_icon.svg"
                    WidthRequest="24"
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3" Margin="14,0,0,0">
                            <Label Text="Ingresar manualmente" FontSize="15" FontAttributes="Bold" TextColor="#1E3A5F" />
                            <Label Text="Escribe tu código de acceso" FontSize="12" TextColor="#6B7280" />
                        </VerticalStackLayout>

                        <Label
                Grid.Column="2"
                Text="›"
                FontSize="24"
                TextColor="#EA580C"
                VerticalOptions="Center" />

                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ManualCommand}" />
                    </Border.GestureRecognizers>
                </Border>

            </VerticalStackLayout>

            <!-- Próxima clase -->
            <VerticalStackLayout Spacing="10">

                <Label
                    Text="Próxima clase"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#6B7280" />

                <Border StrokeShape="RoundRectangle 16" Padding="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <Border
                            Grid.Column="0"
                            WidthRequest="48"
                            HeightRequest="48"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{Binding ProximaClase.Acento}"
                            VerticalOptions="Center"
                            Style="{x:Null}">
                            <Label
                                Text="{Binding ProximaClase.Iniciales}"
                                TextColor="White"
                                FontSize="15"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4" Margin="14,0,0,0">
                            <Label Text="{Binding ProximaClase.Nombre}" FontSize="16" FontAttributes="Bold" />
                            <Label Text="{Binding ProximaClase.Profesor}" FontSize="13" TextColor="#6B7280" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End" Spacing="4">
                            <Label Text="{Binding ProximaClase.HoraInicio}" FontSize="14" FontAttributes="Bold" TextColor="#2563EB" HorizontalOptions="End" />
                            <Label Text="{Binding ProximaClase.Salon}" FontSize="12" TextColor="#9CA3AF" HorizontalOptions="End" />
                        </VerticalStackLayout>

                    </Grid>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>