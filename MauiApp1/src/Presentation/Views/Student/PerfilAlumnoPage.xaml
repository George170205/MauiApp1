<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.src.Presentation.Views.PerfilAlumnoPage"
             BackgroundColor="#F4F6FA"
             Title="Mi Perfil">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">

            <Label Text="Mi Perfil" FontSize="24" FontAttributes="Bold" TextColor="#1A1A2E" />

            <Border StrokeThickness="1" Stroke="#E8ECF0" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="20">
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16">

                    <Border Grid.Column="0" WidthRequest="70" HeightRequest="70" StrokeShape="RoundRectangle 35" StrokeThickness="0" BackgroundColor="#DBEAFE" VerticalOptions="Center">
                        <Label Text="{Binding Iniciales}" FontSize="24" FontAttributes="Bold" TextColor="#2563EB" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding NombreCompleto}" FontSize="20" FontAttributes="Bold" TextColor="#1A1A2E" />
                        <Label Text="{Binding Carrera}" FontSize="14" TextColor="#4B5563" />
                        <Label Text="{Binding Matricula, StringFormat='Matrícula: {0}'}" FontSize="12" TextColor="#9CA3AF" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="16">

                <Border Grid.Column="0" StrokeThickness="1" Stroke="#E8ECF0" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Asistencia" FontSize="13" TextColor="#6B7280" />
                        <Label Text="{Binding PorcentajeGlobal, StringFormat='{0}%'}" FontSize="28" FontAttributes="Bold" TextColor="#16A34A" />
                        <Label Text="Global" FontSize="12" TextColor="#9CA3AF" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" StrokeThickness="1" Stroke="#E8ECF0" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Faltas" FontSize="13" TextColor="#6B7280" />
                        <Label Text="{Binding FaltasTotales}" FontSize="28" FontAttributes="Bold" TextColor="#EF4444" />
                        <Label Text="Acumuladas" FontSize="12" TextColor="#9CA3AF" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <Label Text="Opciones" FontSize="16" FontAttributes="Bold" TextColor="#1A1A2E" Margin="0,8,0,-8" />

            <Border StrokeThickness="1" Stroke="#E8ECF0" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="0">
                <CollectionView ItemsSource="{Binding OpcionesMenu}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto, *, Auto" Padding="16" RowDefinitions="Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Comando}" />
                                </Grid.GestureRecognizers>

                                <Grid Grid.Column="0" WidthRequest="40" HeightRequest="40" Margin="0,0,16,0">
                                    <Border StrokeThickness="0" BackgroundColor="{Binding ColorIcono}" Opacity="0.15" StrokeShape="RoundRectangle 10" />
                                    <Image Source="{Binding Icono}" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Titulo}" FontSize="16" FontAttributes="Bold" TextColor="#1A1A2E" />
                                    <Label Text="{Binding Descripcion}" FontSize="12" TextColor="#6B7280" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2" Text="›" FontSize="24" TextColor="#D1D5DB" VerticalOptions="Center" FontAttributes="Bold" />

                                <BoxView Grid.ColumnSpan="3" HeightRequest="1" Color="#F3F4F6" VerticalOptions="End" Margin="-16,0,-16,-16" />
                            </Grid> 
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <Button Text="Cerrar Sesión" 
                    Command="{Binding CerrarSesionCommand}"
                    BackgroundColor="Transparent" 
                    TextColor="#EF4444" 
                    FontAttributes="Bold" 
                    BorderColor="#EF4444" 
                    BorderWidth="1"
                    CornerRadius="12"
                    Margin="0,10,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>