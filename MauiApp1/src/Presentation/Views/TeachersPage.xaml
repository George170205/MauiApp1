<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.TeachersPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F9FAFB">

    <!--Resources-->
    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Colores de la paleta -->
            <Color x:Key="PrimaryBlue">#3949AB</Color>
            <Color x:Key="SecondaryBlue">#5C6BC0</Color>
            <Color x:Key="BackgroundLight">#F9FAFB</Color>
            <Color x:Key="CardBackground">#FFFFFF</Color>
            <Color x:Key="TextPrimary">Black</Color>
            <Color x:Key="TextSecondary">#6B7280</Color>
            <Color x:Key="WarningYellow">#F59E0B</Color>
            <Color x:Key="WarningRed">#EF4444</Color>

            <!-- Estilos reutilizables -->
            <Style x:Key="HeaderStyle" TargetType="Label">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Margin" Value="20,20,20,10"/>
            </Style>

            <Style x:Key="SubHeaderStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                <Setter Property="Margin" Value="20,0,20,20"/>
            </Style>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="Margin" Value="20,10" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Stroke" Value="#E5E7EB" />

                <!-- Esquinas redondeadas -->
                <Setter Property="StrokeShape">
                    <RoundRectangle CornerRadius="15" />
                </Setter>

                <!-- Sombra -->
                <Setter Property="Shadow">
                    <Shadow
                        Opacity="0.08"
                        Radius="12"
                        Offset="0,2" />
                </Setter>
            </Style>

            <Style x:Key="StatLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
            </Style>

            <Style x:Key="StatDescriptionStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout>
            <!-- Header con información del profesor -->
            <Grid HeightRequest="220">
                <!-- Contenido del header -->
                <Grid VerticalOptions="Start" Margin="20,20,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barra superior con Logo y menú -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,30">
                        <!-- Logo/Nombre de la App -->
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Border WidthRequest="32"
                                    HeightRequest="32"
                                    StrokeThickness="0"
                                    BackgroundColor="#3949AB"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                            </Border>
                            <Label Text="EduPortal"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="Black"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <!-- Botón de 3 puntos (configuración) -->
                        <Border Grid.Column="2"
                                WidthRequest="40"
                                HeightRequest="40"
                                StrokeThickness="0"
                                BackgroundColor="Transparent"
                                HorizontalOptions="End"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnConfiguracionClicked"/>
                            </Border.GestureRecognizers>
                            <Label Text="⋮"
                                   FontSize="24"
                                   TextColor="Gray"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Margin="0,-4,0,0"/>
                        </Border>
                    </Grid>

                    <!-- Barra decorativa inferior -->
                    <Border HeightRequest="1"
                            Margin="-20,30,-20,0"
                            StrokeThickness="0"
                            BackgroundColor="#DADCE0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0"/>
                        </Border.StrokeShape>
                    </Border>

                    <!-- Información del Profesor (Tarjeta) -->
                    <Border Grid.Row="1"
                            Padding="20,16"
                            BackgroundColor="#FFFFFF"
                            StrokeThickness="0"
                            Margin="0,0,0,20"
                            VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.1"/>
                        </Border.Shadow>

                        <HorizontalStackLayout Spacing="15">
                            <!-- Avatar con iniciales -->
                            <Border WidthRequest="60"
                                    HeightRequest="60"
                                    StrokeThickness="0"
                                    BackgroundColor="#3949AB"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="30"/>
                                </Border.StrokeShape>
                                <Label Text="JM"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <!-- Información del profesor -->
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="Prof. Juan Martínez"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937"/>
                                <Label Text="Matemáticas Avanzadas"
                                       FontSize="13"
                                       TextColor="#6B7280"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Grid>

            <!-- Accesos Rápidos -->
            <Grid Margin="20,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Botón Mis Grupos -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMisGruposTapped"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Border WidthRequest="90" HeightRequest="50" 
                                Padding="0"
                                BackgroundColor="White"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="5" Style="{StaticResource StatLabelStyle}" 
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Mis Grupos" FontSize="12" FontAttributes="Bold" 
                               TextColor="{StaticResource TextSecondary}"   
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Botón Asistencias -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAsistenciasTapped"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Border WidthRequest="90" HeightRequest="50" 
                                Padding="0" 
                                BackgroundColor="#FFFFFF" 
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="156" Style="{StaticResource StatLabelStyle}" 
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Asistencias" FontSize="12" FontAttributes="Bold" 
                               TextColor="{StaticResource TextSecondary}"   
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Botón Calificaciones -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCalificacionesTapped"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Border WidthRequest="90" HeightRequest="50" 
                                Padding="0" 
                                BackgroundColor="#FFFFFF" 
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="8.5" Style="{StaticResource StatLabelStyle}" 
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Promedio" FontSize="12" FontAttributes="Bold" 
                               TextColor="{StaticResource TextSecondary}"   
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Código QR de Asistencia -->
            <Border Style="{StaticResource CardStyle}" Margin="20,40">
                <VerticalStackLayout Spacing="15">
                    <!-- Título -->
                    <HorizontalStackLayout Spacing="10">
                        <Border WidthRequest="40" HeightRequest="40" 
                                Padding="0" 
                                BackgroundColor="#EEF2FF" 
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Label Text="📱" FontSize="20" 
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                            <Label Text="Código QR de Asistencia" 
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Activo para la clase actual" 
                                   FontSize="11"
                                   TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Separador -->
                    <BoxView HeightRequest="1" 
                             Color="#E5E7EB" 
                             Margin="0,5,0,10"/>

                    <!-- QR Code Grid -->
                    <Frame CornerRadius="10" 
                           Padding="15"
                           BackgroundColor="White"
                           BorderColor="#E5E7EB"
                           HasShadow="False"
                           HorizontalOptions="Center">
                        <Grid x:Name="QRGrid" 
                              RowDefinitions="20,20,20,20,20,20,20,20"
                              ColumnDefinitions="20,20,20,20,20,20,20,20"
                              RowSpacing="0"
                              ColumnSpacing="0"
                              WidthRequest="160"
                              HeightRequest="160"
                              BackgroundColor="White">
                            <!-- QR pattern will be generated in code-behind -->
                        </Grid>
                    </Frame>

                    <!-- Timer -->
                    <Frame CornerRadius="20" 
                           Padding="12,8"
                           BackgroundColor="#FFF8E1"
                           HasShadow="False"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0">
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="⏱️" FontSize="14"/>
                            <Label Text="Expira en 4:30 min" 
                                   FontSize="12" 
                                   TextColor="#F57F17"
                                   FontAttributes="Bold"/>
                        </HorizontalStackLayout>
                    </Frame>

                    <!-- Botón Regenerar QR -->
                    <Button Text="Regenerar Código QR"
                            BackgroundColor="#3949AB"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="45"
                            Margin="0,10,0,0"
                            Clicked="OnRegenerarQRClicked"/>
                </VerticalStackLayout>
            </Border>

            <!-- Próxima Clase -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="15">
                    <!-- Título -->
                    <Label Text="Próxima Clase" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="Black"/>

                    <!-- Separador -->
                    <BoxView HeightRequest="1" 
                             Color="#E5E7EB" 
                             Margin="0,0,0,5"/>

                    <!-- Información de la clase -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <!-- Icono de calendario -->
                        <Border Grid.Column="0"
                                WidthRequest="50"
                                HeightRequest="50"
                                Padding="0"
                                BackgroundColor="#E3F2FD"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="📅" FontSize="24" 
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <!-- Detalles -->
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="Hoy 10:30 AM" 
                                   FontSize="14" 
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Grupo 5A - Álgebra Lineal" 
                                   FontSize="13" 
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Aula 205 | 32 alumnos" 
                                   FontSize="12" 
                                   TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Botón -->
                    <Button Text="Ver Detalles de la Clase"
                            BackgroundColor="Transparent"
                            TextColor="#3949AB"
                            BorderColor="#3949AB"
                            BorderWidth="1"
                            CornerRadius="10"
                            HeightRequest="45"
                            Margin="0,10,0,0"
                            Clicked="OnVerClaseClicked"/>
                </VerticalStackLayout>
            </Border>

            <!-- Actividad Reciente -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="15">
                    <HorizontalStackLayout Spacing="10">
                        <Border WidthRequest="40" HeightRequest="40" 
                                Padding="0" 
                                BackgroundColor="#F0FDF4" 
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Label Text="📊" FontSize="20" 
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                            <Label Text="Actividad Reciente" 
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Últimas acciones del día" 
                                   FontSize="11"
                                   TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Separador -->
                    <BoxView HeightRequest="1" 
                             Color="#E5E7EB" 
                             Margin="0,0,0,5"/>

                    <!-- Lista de actividades -->
                    <StackLayout Spacing="12" Margin="0,5,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Asistencia registrada - Grupo 3B" 
                                   FontSize="13" 
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="8:45 AM" 
                                   FontSize="12" 
                                   TextColor="{StaticResource TextSecondary}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Calificaciones subidas - Examen Parcial" 
                                   FontSize="13" 
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="7:30 AM" 
                                   FontSize="12" 
                                   TextColor="{StaticResource TextSecondary}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Material compartido - Unidad 4" 
                                   FontSize="13" 
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="Ayer" 
                                   FontSize="12" 
                                   TextColor="{StaticResource TextSecondary}"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </StackLayout>

                    <!-- Botón Ver todas -->
                    <Button Text="Ver Todas las Actividades"
                            BackgroundColor="Transparent"
                            TextColor="#3949AB"
                            BorderColor="#3949AB"
                            BorderWidth="1"
                            CornerRadius="10"
                            HeightRequest="45"
                            Margin="0,10,0,0"
                            Clicked="OnVerActividadesClicked"/>
                </VerticalStackLayout>
            </Border>

            <!-- Alertas Pendientes -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="15">
                    <HorizontalStackLayout Spacing="10">
                        <Border WidthRequest="40" HeightRequest="40" 
                                Padding="0" 
                                BackgroundColor="#FEF2F2" 
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Label Text="⚠️" FontSize="20" 
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                            <Label Text="Alertas Pendientes" 
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="2 alertas requieren atención" 
                                   FontSize="11"
                                   TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Separador -->
                    <BoxView HeightRequest="1" 
                             Color="#E5E7EB" 
                             Margin="0,0,0,5"/>

                    <!-- Lista de alertas -->
                    <StackLayout Spacing="10" Margin="0,5,0,0">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="•" FontSize="20" TextColor="#EF4444" VerticalOptions="Center"/>
                            <Label Text="5 alumnos con baja asistencia (&lt;75%)"
                                   FontSize="13" TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="•" FontSize="20" TextColor="#F59E0B" VerticalOptions="Center"/>
                            <Label Text="3 calificaciones pendientes de capturar"
                                   FontSize="13" TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </StackLayout>

                    <!-- Botón Ver todas -->
                    <Button Text="Ver Todas las Alertas"
                            BackgroundColor="#1F2937"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="45"
                            Margin="0,10,0,0"
                            Clicked="OnVerAlertasClicked"/>
                </VerticalStackLayout>
            </Border>

            <!-- Espacio final para la navegación -->
            <BoxView HeightRequest="80" Color="Transparent"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
