<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.src.Presentation.Views.AsistenciaPage"
             BackgroundColor="#F4F6FA"
             Title="Asistencia">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="#1A1A2E" />
        </Style>
        <Style TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="#E8ECF0" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <!-- Fecha -->
            <Label
                Text="{Binding FechaHoy}"
                FontSize="22"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                Margin="0,8,0,0" />

            <!-- Clase actual -->
            <VerticalStackLayout Spacing="10">

                <Label
                    Text="Clase actual"
                    FontSize="13"
                    TextColor="#6B7280"
                    FontAttributes="Bold" />

                <Border StrokeShape="RoundRectangle 16" Padding="0" HeightRequest="130">
                    <Grid ColumnDefinitions="8,*,Auto">

                        <BoxView
                            Grid.Column="0"
                            Color="{Binding ClaseActual.Acento}"
                            CornerRadius="16,0,16,0" />

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="6"
                            Padding="16"
                            VerticalOptions="Center">

                            <Label
                                Text="{Binding ClaseActual.Nombre}"
                                FontSize="17"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding ClaseActual.Profesor}"
                                FontSize="13"
                                TextColor="#6B7280" />

                            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
                                <Label Grid.Column="0" Text="Hora inicio" FontSize="12" TextColor="#9CA3AF" />
                                <Label Grid.Column="1" Text="{Binding ClaseActual.HoraInicio}" FontSize="12" />
                                <Label Grid.Column="2" Text="{Binding ClaseActual.Salon}" FontSize="12" TextColor="#9CA3AF" />
                                <Label Grid.Column="3" Text="{Binding ClaseActual.Tipo}" FontSize="12" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="Hora fin   " FontSize="12" TextColor="#9CA3AF" />
                                <Label Grid.Column="1" Text="{Binding ClaseActual.HoraFin}" FontSize="12" />
                            </Grid>

                        </VerticalStackLayout>

                        <Border
                            Grid.Column="2"
                            BackgroundColor="{Binding ClaseActual.Acento}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="10,4"
                            VerticalOptions="Start"
                            Margin="0,12,12,0"
                            Style="{x:Null}">
                            <Label
                                Text="{Binding ClaseActual.Porcentaje, StringFormat='{0}%'}"
                                TextColor="White"
                                FontSize="12"
                                FontAttributes="Bold" />
                        </Border>

                    </Grid>
                </Border>

            </VerticalStackLayout>

            <!-- Registrar asistencia -->
            <VerticalStackLayout Spacing="12">

                <Label
                    Text="Registrar asistencia"
                    FontSize="15"
                    FontAttributes="Bold"
                    HorizontalOptions="Center" />

                <Border
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="#2563EB"
                    StrokeThickness="0"
                    Padding="0"
                    HeightRequest="52"
                    Style="{x:Null}">
                    <Label
                        Text="Escanea tu codigo aqui"
                        TextColor="White"
                        FontSize="15"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EscanearCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>

                <Border
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="#F59E0B"
                    StrokeThickness="0"
                    Padding="0"
                    HeightRequest="52"
                    Style="{x:Null}">
                    <Label
                        Text="Escribelo manualmente"
                        TextColor="White"
                        FontSize="15"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ManualCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>

            </VerticalStackLayout>

            <!-- Próxima clase -->
            <VerticalStackLayout Spacing="10">

                <Label
                    Text="Próxima clase:"
                    FontSize="17"
                    FontAttributes="Bold" />

                <Border StrokeShape="RoundRectangle 16" Padding="16">
                    <HorizontalStackLayout Spacing="14">

                        <!-- Avatar materia -->
                        <Border
                            WidthRequest="48"
                            HeightRequest="48"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 24"
                            BackgroundColor="{Binding ProximaClase.Acento}"
                            VerticalOptions="Center"
                            Style="{x:Null}">
                            <Label
                                Text="{Binding ProximaClase.Iniciales}"
                                TextColor="White"
                                FontSize="15"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                            <Label
                                Text="{Binding ProximaClase.Nombre}"
                                FontSize="16"
                                FontAttributes="Bold" />
                            <Label
                                Text="{Binding ProximaClase.Profesor}"
                                FontSize="13"
                                TextColor="#6B7280" />
                        </VerticalStackLayout>

                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>